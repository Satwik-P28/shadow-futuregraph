      "upper": 800,
      "scale": 800,
      "unit": "usd",
      "distribution": "uniform",
      "epistemic_status": "ESTIMATED"
    },
    {
      "id": "commute_traffic_min",
      "label": "Commute traffic",
      "role": "exogenous",
      "vtype": "number",
      "baseline": 0,
      "lower": 0,
      "upper": 40,
      "scale": 40,
      "unit": "min",
      "distribution": "uniform",
      "epistemic_status": "ESTIMATED"
    },
    {
      "id": "overlap_days",
      "label": "Lease overlap",
      "role": "derived",
      "vtype": "number",
      "unit": "day",
      "epistemic_status": "COMPUTED",
      "show_in_diff": true,
      "formula": {
        "op": "max",
        "args": [
          {"op": "const", "value": 0},
          {"op": "sub", "args": [{"op": "var", "ref": "old_lease_end"}, {"op": "var", "ref": "new_lease_start"}]}
        ]
      }
    },
    {
      "id": "commute_min",
      "label": "Thursday commute",
      "role": "derived",
      "vtype": "number",
      "unit": "min",
      "epistemic_status": "COMPUTED",
      "formula": {
        "op": "if",
        "args": [
          {"op": "gt", "args": [{"op": "var", "ref": "move_day"}, {"op": "var", "ref": "thursday_day"}]},
          {"op": "const", "value": 20},
          {"op": "add", "args": [{"op": "const", "value": 42}, {"op": "var", "ref": "commute_traffic_min"}]}
        ]
      }
    },
    {
      "id": "cash_needed_usd",
      "label": "Cash required",
      "role": "derived",
      "vtype": "number",
      "unit": "usd",
      "epistemic_status": "COMPUTED",
      "show_in_diff": true,
      "formula": {
        "op": "add",
        "args": [
          {"op": "var", "ref": "deposit_usd"},
          {"op": "var", "ref": "movers_usd"},
          {"op": "mul", "args": [{"op": "var", "ref": "overlap_days"}, {"op": "var", "ref": "overlap_daily_usd"}]},
          {"op": "var", "ref": "fee_surprise_usd"},
          {"op": "var", "ref": "change_fee_usd"}
        ]
      }
    },
    {
      "id": "pickup_ok",
      "label": "Thursday pickup still works",
      "role": "derived",
      "vtype": "bool",
      "epistemic_status": "COMPUTED",
      "formula": {
        "op": "or",
        "args": [
          {"op": "eq", "args": [{"op": "var", "ref": "alternate_pickup"}, {"op": "const", "value": true}]},
          {"op": "lte", "args": [{"op": "var", "ref": "commute_min"}, {"op": "const", "value": 50}]}
        ]
      }
    }
  ],
  "constraints": [
    {
      "id": "c_cash",
      "label": "Cash covers deposit, overlap, and fees",
      "kind": "resource",
      "hardness": "hard",
      "description": "Cash has to cover the deposit, overlapping rent, movers, and surprise fees.",
      "relaxable": true,
      "expr": {"op": "lte", "args": [{"op": "var", "ref": "cash_needed_usd"}, {"op": "var", "ref": "cash_usd"}]}
    },
    {
      "id": "c_pickup",
      "label": "Thursday onsite pickup still reachable",
      "kind": "temporal",
      "hardness": "hard",
      "description": "The recurring Thursday pickup cannot be missed.",
      "expr": {"op": "eq", "args": [{"op": "var", "ref": "pickup_ok"}, {"op": "const", "value": true}]}
    }
  ],
