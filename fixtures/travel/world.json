    },
    {
      "id": "b1440",
      "label": "Afternoon Friday flight",
      "action_ids": ["set_flight_1440", "set_ride_1440", "confirm_friday"],
      "rationale": "Lowest fare that still reaches dinner on the nominal schedule."
    },
    {
      "id": "b1710",
      "label": "Evening Friday flight",
      "action_ids": ["set_flight_1710", "set_ride_1710", "confirm_friday"],
      "rationale": "Cheapest listed fare."
    },
    {
      "id": "b_flight_only",
      "label": "Change the flight and leave the ride",
      "action_ids": ["set_flight_1120", "confirm_friday"],
      "rationale": "Incomplete repair that does not move the ride."
    },
    {
      "id": "b_dinner",
      "label": "Keep the cheap flight and move dinner",
      "action_ids": ["set_flight_1710", "set_ride_1710", "confirm_friday", "move_dinner"],
      "rationale": "Violates the fixed dinner to make a late flight look viable."
    }
