{
  "id": "travel",
  "title": "Alex moves the NYC trip to Friday",
  "domain": "travel",
  "plan_prompt": "Move my NYC trip to Friday and make sure everything still works.",
  "metadata": {
    "persona": "Alex",
    "provider_mode": "sandbox",
    "synthetic": true
  },
  "variables": [
    {
      "id": "trip_day",
      "label": "Trip day",
      "role": "controllable",
      "vtype": "category",
      "baseline": "thursday",
      "epistemic_status": "VERIFIED",
      "show_in_diff": true
    },
    {
      "id": "flight_departure_min",
      "label": "Flight",
      "role": "controllable",
      "vtype": "number",
      "baseline": 880,
      "unit": "clock",
      "epistemic_status": "VERIFIED",
      "show_in_diff": true
    },
    {
      "id": "ride_pickup_min",
      "label": "Airport ride",
      "role": "controllable",
      "vtype": "number",
      "baseline": 725,
      "unit": "clock",
      "epistemic_status": "VERIFIED",
      "show_in_diff": true
    },
    {
      "id": "incremental_cost_usd",
      "label": "Fare change",
      "role": "controllable",
      "vtype": "number",
      "baseline": 0,
      "unit": "usd",
      "epistemic_status": "VERIFIED",
      "show_in_diff": true
    },
    {
      "id": "fare_adjust_usd",
      "label": "Observed fare adjustment",
      "role": "exogenous",
      "vtype": "number",
      "baseline": 0,
      "lower": 0,
      "upper": 0,
      "scale": 100,
      "unit": "usd",
      "distribution": "point",
      "epistemic_status": "VERIFIED"
    },
    {
      "id": "flight_delay_min",
      "label": "Flight delay",
      "role": "exogenous",
      "vtype": "number",
      "baseline": 0,
      "lower": 0,
      "upper": 180,
      "scale": 180,
      "unit": "min",
      "distribution": "uniform",
      "epistemic_status": "ESTIMATED"
    },
    {
      "id": "traffic_extra_min",
      "label": "Ground traffic",
      "role": "exogenous",
      "vtype": "number",
      "baseline": 0,
      "lower": 0,
      "upper": 150,
      "scale": 150,
      "unit": "min",
      "distribution": "uniform",
      "epistemic_status": "ESTIMATED"
    },
    {
      "id": "block_min",
      "label": "Scheduled block",
      "role": "fixed",
      "vtype": "number",
      "baseline": 75,
      "unit": "min",
      "epistemic_status": "VERIFIED"
    },
    {
      "id": "deplane_min",
      "label": "Deplane and exit",
      "role": "fixed",
      "vtype": "number",
      "baseline": 20,
      "unit": "min",
      "epistemic_status": "VERIFIED",
      "detail": true
    },
    {
      "id": "ground_min",
      "label": "Airport to dinner",
      "role": "fixed",
      "vtype": "number",
      "baseline": 50,
      "unit": "min",
      "epistemic_status": "VERIFIED"
    },
    {
      "id": "dinner_deadline_min",
      "label": "Dinner deadline",
      "role": "controllable",
      "vtype": "number",
      "baseline": 1140,
      "unit": "clock",
      "epistemic_status": "VERIFIED",
      "show_in_diff": true
    },
    {
      "id": "dinner_fixed",
      "label": "Dinner stays put",
      "role": "controllable",
      "vtype": "bool",
      "baseline": true,
      "epistemic_status": "VERIFIED"
    },
    {
      "id": "review_end_min",
      "label": "Design review ends",
      "role": "fixed",
      "vtype": "number",
      "baseline": 540,
      "unit": "clock",
      "epistemic_status": "VERIFIED"
    },
    {
      "id": "review_changed",
      "label": "Design review changed",
      "role": "controllable",
      "vtype": "bool",
      "baseline": false,
      "epistemic_status": "VERIFIED"
    },
    {
      "id": "exam_changed",
      "label": "Algorithms exam changed",
      "role": "controllable",
      "vtype": "bool",
      "baseline": false,
      "epistemic_status": "VERIFIED"
    },
    {
      "id": "hotel_status",
      "label": "Hotel",
      "role": "controllable",
      "vtype": "category",
      "baseline": "confirmed",
      "epistemic_status": "VERIFIED",
      "show_in_diff": true
    },
    {
      "id": "replacement_confirmed",
      "label": "Replacement booking confirmed",
      "role": "controllable",
      "vtype": "bool",
      "baseline": false,
      "epistemic_status": "VERIFIED"
    },
    {
      "id": "street_closure",
      "label": "Unconfirmed street closure",
      "role": "exogenous",
      "vtype": "bool",
      "baseline": null,
      "distribution": "unknown",
      "epistemic_status": "UNKNOWN"
    },
    {
      "id": "dinner_arrival_min",
      "label": "Arrival at dinner",
      "role": "derived",
      "vtype": "number",
      "unit": "clock",
      "epistemic_status": "COMPUTED",
      "show_in_diff": true,
      "formula": {
        "op": "add",
        "args": [
          {"op": "var", "ref": "flight_departure_min"},
          {"op": "var", "ref": "block_min"},
          {"op": "var", "ref": "deplane_min"},
          {"op": "var", "ref": "ground_min"},
          {"op": "var", "ref": "flight_delay_min"},
          {"op": "var", "ref": "traffic_extra_min"}
        ]
      }
    },
    {
      "id": "leave_home_min",
      "label": "Leave home",
      "role": "derived",
      "vtype": "number",
      "unit": "clock",
      "epistemic_status": "COMPUTED",
      "detail": true,
      "formula": {
        "op": "sub",
        "args": [
          {"op": "var", "ref": "flight_departure_min"},
          {"op": "const", "value": 100}
        ]
      }
    },
    {
      "id": "ride_expected_min",
      "label": "Ride required by flight",
      "role": "derived",
      "vtype": "number",
      "unit": "clock",
      "epistemic_status": "COMPUTED",
      "detail": true,
      "formula": {
        "op": "sub",
        "args": [
          {"op": "var", "ref": "flight_departure_min"},
          {"op": "const", "value": 155}
        ]
      }
    },
    {
      "id": "total_cost_usd",
      "label": "Incremental cost",
      "role": "derived",
      "vtype": "number",
      "unit": "usd",
      "epistemic_status": "COMPUTED",
      "show_in_diff": true,
      "formula": {
        "op": "add",
        "args": [
          {"op": "var", "ref": "incremental_cost_usd"},
          {"op": "var", "ref": "fare_adjust_usd"}
        ]
      }
    }
  ],
  "constraints": [
    {
      "id": "c_dinner",
      "label": "Arrive by dinner",
      "kind": "temporal",
      "hardness": "hard",
      "description": "Alex must reach dinner by 19:00.",
      "relaxable": true,
      "expr": {
        "op": "lte",
        "args": [
          {"op": "var", "ref": "dinner_arrival_min"},
          {"op": "var", "ref": "dinner_deadline_min"}
        ]
      }
    },
    {
      "id": "c_budget",
      "label": "Incremental cost within $100",
      "kind": "resource",
      "hardness": "hard",
      "description": "The fare change must stay within the $100 cap.",
      "relaxable": true,
      "expr": {
        "op": "lte",
        "args": [
          {"op": "var", "ref": "total_cost_usd"},
          {"op": "const", "value": 100}
        ]
      }
    },
    {
      "id": "c_dinner_fixed",
      "label": "Dinner does not move",
      "kind": "boolean",
      "hardness": "hard",
      "description": "Dinner is with another person and cannot be moved.",
      "expr": {"op": "eq", "args": [{"op": "var", "ref": "dinner_fixed"}, {"op": "const", "value": true}]}
    },
    {
      "id": "c_review",
      "label": "Design review stays",
      "kind": "equality",
      "hardness": "hard",
      "description": "The Friday design review is fixed.",
      "expr": {"op": "eq", "args": [{"op": "var", "ref": "review_changed"}, {"op": "const", "value": false}]}
    },
    {
      "id": "c_exam",
      "label": "Algorithms exam stays",
      "kind": "equality",
      "hardness": "hard",
      "description": "The unrelated algorithms exam must not change.",
      "expr": {"op": "eq", "args": [{"op": "var", "ref": "exam_changed"}, {"op": "const", "value": false}]}
    },
    {
      "id": "c_leave",
      "label": "Leave after the design review",
      "kind": "temporal",
      "hardness": "hard",
      "description": "Alex cannot leave for the airport before the review ends.",
      "expr": {
        "op": "gte",
        "args": [
          {"op": "var", "ref": "leave_home_min"},
          {"op": "var", "ref": "review_end_min"}
        ]
      }
    },
    {
      "id": "c_ride",
      "label": "Ride matches the flight",
      "kind": "sequence",
      "hardness": "hard",
      "description": "The airport ride has to move with the flight.",
      "expr": {
        "op": "eq",
        "args": [
          {"op": "var", "ref": "ride_pickup_min"},
          {"op": "var", "ref": "ride_expected_min"}
        ]
      }
    },
    {
      "id": "c_friday",
      "label": "Trip is on Friday",
      "kind": "equality",
      "hardness": "hard",
      "description": "The requested trip day is Friday.",
      "expr": {"op": "eq", "args": [{"op": "var", "ref": "trip_day"}, {"op": "const", "value": "friday"}]}
    },
    {
      "id": "c_hotel",
      "label": "Hotel remains confirmed",
      "kind": "equality",
      "hardness": "hard",
      "description": "The hotel booking has to stay confirmed.",
      "expr": {"op": "eq", "args": [{"op": "var", "ref": "hotel_status"}, {"op": "const", "value": "confirmed"}]}
    },
    {
      "id": "c_replacement",
      "label": "Old booking held until replacement confirms",
      "kind": "sequence",
      "hardness": "hard",
      "description": "The Thursday booking stays until the Friday replacement is confirmed.",
      "expr": {
        "op": "eq",
        "args": [
          {"op": "var", "ref": "replacement_confirmed"},
          {"op": "const", "value": true}
        ]
      }
    }
  ],
